<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:include filename="$(find panda_gazebo_bringup)/urdf/panda_common.xacro"/>

  <xacro:macro name="panda_arm_gazebo"
               params="arm_id:='panda' description_pkg:='franka_description' safety_distance:=0 joint_limits">
    <xacro:link_with_collision name="link0" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="-0.075 0 0.06" direction="x"
                                 radius="${0.06 + safety_distance}" length="0.03"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <xacro:link_with_collision name="link1" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="0 0 -0.1915"
                                 radius="${0.06 + safety_distance}" length="0.283"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <joint name="${arm_id}_joint1" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.333"/>
      <parent link="${arm_id}_link0"/>
      <child link="${arm_id}_link1"/>
      <axis xyz="0 0 1"/>
      <xacro:panda_limits name="joint1" config="${joint_limits}"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <xacro:link_with_collision name="link2" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="0 0 0"
                                 radius="${0.06 + safety_distance}" length="0.12"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <joint name="${arm_id}_joint2" type="revolute">
      <origin rpy="${-pi / 2} 0 0" xyz="0 0 0"/>
      <parent link="${arm_id}_link1"/>
      <child link="${arm_id}_link2"/>
      <axis xyz="0 0 1"/>
      <xacro:panda_limits name="joint2" config="${joint_limits}"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <xacro:link_with_collision name="link3" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="0 0 -0.145"
                                 radius="${0.06 + safety_distance}" length="0.15"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <joint name="${arm_id}_joint3" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0 -0.316 0"/>
      <parent link="${arm_id}_link2"/>
      <child link="${arm_id}_link3"/>
      <axis xyz="0 0 1"/>
      <xacro:panda_limits name="joint3" config="${joint_limits}"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <xacro:link_with_collision name="link4" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="0 0 0"
                                 radius="${0.06 + safety_distance}" length="0.12"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <joint name="${arm_id}_joint4" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0.0825 0 0"/>
      <parent link="${arm_id}_link3"/>
      <child link="${arm_id}_link4"/>
      <axis xyz="0 0 1"/>
      <xacro:panda_limits name="joint4" config="${joint_limits}"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <xacro:link_with_collision name="link5" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="0 0 -0.26"
                                 radius="${0.060 + safety_distance}" length="0.10"/>
        <xacro:collision_capsule xyz="0 0.08 -0.13"
                                 radius="${0.025 + safety_distance}" length="0.14"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <joint name="${arm_id}_joint5" type="revolute">
      <origin rpy="${-pi / 2} 0 0" xyz="-0.0825 0.384 0"/>
      <parent link="${arm_id}_link4"/>
      <child link="${arm_id}_link5"/>
      <axis xyz="0 0 1"/>
      <xacro:panda_limits name="joint5" config="${joint_limits}"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <xacro:link_with_collision name="link6" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="0 0 -0.03"
                                 radius="${0.05 + safety_distance}" length="0.08"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <joint name="${arm_id}_joint6" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0 0 0"/>
      <parent link="${arm_id}_link5"/>
      <child link="${arm_id}_link6"/>
      <axis xyz="0 0 1"/>
      <xacro:panda_limits name="joint6" config="${joint_limits}"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <xacro:link_with_collision name="link7" arm_id="${arm_id}" description_pkg="${description_pkg}">
      <collision_geometries>
        <xacro:collision_capsule xyz="0 0 0.01" direction="z"
                                 radius="${0.04 + safety_distance}" length="0.14"/>
        <xacro:collision_capsule xyz="0.06 0 0.082" direction="x"
                                 radius="${0.03 + safety_distance}" length="0.01"/>
      </collision_geometries>
    </xacro:link_with_collision>

    <joint name="${arm_id}_joint7" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0.088 0 0"/>
      <parent link="${arm_id}_link6"/>
      <child link="${arm_id}_link7"/>
      <axis xyz="0 0 1"/>
      <xacro:panda_limits name="joint7" config="${joint_limits}"/>
      <dynamics damping="0.003" friction="0.0"/>
    </joint>

    <link name="${arm_id}_link8"/>

    <joint name="${arm_id}_joint8" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.107"/>
      <parent link="${arm_id}_link7"/>
      <child link="${arm_id}_link8"/>
    </joint>
  </xacro:macro>
</robot>
